# ─── 필수 ────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# ─── Obsidian ─────────────────────────────────────────────────────
OBSIDIAN_VAULT_PATH=~/ObsidianVault
OBSIDIAN_PAPERS_SUBDIR=Papers
OBSIDIAN_RELATED_COUNT=3

# ─── Ollama ───────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT=180          # 요약 1편당 응답 타임아웃(초)
OLLAMA_NUM_CTX=8192         # 컨텍스트 윈도우 (본문을 많이 넣을수록 크게)
OLLAMA_NUM_PREDICT=1536     # 요약 최대 생성 토큰
OLLAMA_MAX_RETRIES=2        # 요약 실패(타임아웃·파싱오류) 시 재시도 횟수

# ─── arXiv ────────────────────────────────────────────────────────
ARXIV_MAX_RESULTS=5
ARXIV_CATEGORIES=cs.LG,cs.CL,cs.CV,cs.AI

# ─── HuggingFace Papers 트렌딩 ────────────────────────────────────
HF_TRENDING_LIMIT=20       # 수집할 최대 논문 수
HF_MIN_UPVOTES=5           # 최소 upvote 수 (낮을수록 더 많이 수집)

# ─── PDF 추출 ─────────────────────────────────────────────────────
PDF_CACHE_DIR=.pdf_cache
PDF_MAX_PAGES=15
PDF_MAX_SECTION_CHARS=1800  # 섹션당 본문 최대 글자
PDF_MAX_TOTAL_CHARS=14000   # 프롬프트에 넣을 본문 총량 (클수록 요약 풍부, 느려짐)

# ─── 기타 ─────────────────────────────────────────────────────────
DB_PATH=papers.db
